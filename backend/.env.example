# Copy this file to ".env" and fill in real values. Never commit ".env".
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/auth_product_db

# Use long random strings, and make the two secrets DIFFERENT from each other.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Frontend origin allowed by CORS (needed so the browser can send the refresh cookie)
CLIENT_URL=http://localhost:5173

# Only change when frontend and backend are on DIFFERENT domains in production:
# COOKIE_SAMESITE=none   (requires HTTPS, i.e. NODE_ENV=production)
COOKIE_SAMESITE=lax
